# I'm at the Races — local environment overrides.
# Copy to .env (gitignored) and adjust. All variables are optional.
# There are no secrets in this file.

# Runtime data directory (SQLite DB + artifacts).
# Default: <repository>/.races, resolved from the workspace root regardless
# of the process working directory.
# Read by: apps/web (API routes, server components) and apps/worker.
# RACES_DIR=/absolute/path/to/.races

# Web port for local development.
# Read by: apps/web via Next.js (PORT is a Next.js convention).
# PORT=3000

# Model credentials for the agent executor. Read by apps/worker only.
# Never expose a model key through a NEXT_PUBLIC_* variable — anything
# with that prefix is bundled into client JavaScript.
# RACES_MODEL_API_KEY=

# Model ID for the agent executor. Defaults to claude-sonnet-4-5-20250929.
# RACES_MODEL=

# Model provider: anthropic (Anthropic Messages API, default) or
# openai-responses (OpenAI Responses-API-compatible endpoint).
# RACES_MODEL_PROVIDER=

# Base URL for the model endpoint. Required for openai-responses
# (e.g. https://api.meta.ai/v1); optional override for anthropic.
# RACES_MODEL_BASE_URL=
